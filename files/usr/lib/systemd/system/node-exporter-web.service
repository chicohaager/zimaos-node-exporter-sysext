[Unit]
Description=node-exporter tile for ZimaOS (exporters on and off, scrape config)
Documentation=https://github.com/chicohaager/zimaos-node-exporter-sysext
After=network-online.target zimaos-gateway.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/node-exporter-web
Restart=always
RestartSec=5
# Root in the host's namespaces: it runs
# node-exporter-zima and systemctl. No Protect*/Private* directives — they would give the service a
# private mount namespace (measured for modmanager on 1.8.0).
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
